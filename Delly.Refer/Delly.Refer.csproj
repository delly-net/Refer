<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0</TargetFrameworks>
		<Authors>Delly.Net</Authors>
		<Version>1.0.2609.1</Version>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>ref_256.png</PackageIcon>
		<RepositoryUrl>https://github.com/delly-net/Refer</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<!-- 本项目是多目标（TargetFrameworks），Pack 在外层构建执行，此时默认 None 通配项为空，
	     必须用 Include 显式声明。若改用 Update，Pack 元数据不生效，打包会报 NU5046。 -->
	<ItemGroup>
	  <None Remove="README.md" />
	  <None Remove="ref_256.png" />
	  <None Include="README.md" Pack="True" PackagePath="\" />
	  <None Include="ref_256.png" Pack="True" PackagePath="\" />
	</ItemGroup>

</Project>
